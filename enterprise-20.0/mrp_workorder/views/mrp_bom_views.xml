<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_routing_workcenter_tree_view_inherited" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.list.view.inherited</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_total']" position="after">
                <field name="quality_point_count"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_form_view_inherited" model="ir.ui.view">
        <field name="name">mrp.bom.from.inherited</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <button name="action_open_exploded_bom_lines" position="after">
                <button name="%(mrp.mrp_routing_action)d" type="action" context="{'search_default_bom_id': id, 'bom_id_invisible': True}"
                    class="oe_stat_button" icon="manufacturing" groups="mrp.group_mrp_routings" invisible="operation_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="o_stat_value order-1">
                                <field name="operation_count" nolabel="1"/>
                            </span>
                            <span class="o_stat_text order-2">Operations</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1">
                            <span class="o_stat_value">
                                <field name="quality_point_count" nolabel="1"/>
                            </span>
                            <span class="o_stat_text order-2">Instructions</span>
                        </div>
                    </div>
                </button>
            </button>
        </field>
    </record>

    <record id="mrp_routing_workcenter_bom_tree_view" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.bom.list.view.inherited</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quality_point_count']" position="replace"/>
        </field>
    </record>

    <record id="view_mrp_bom_filter_inherit_mrp_workorder" model="ir.ui.view">
        <field name="name">mrp.bom.select.inherit.mrp.workorder</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator invisible="1"/>
                <filter string="My Activities" name="filter_activities_my"
                    domain="[('activity_user_id', '=', uid)]" invisible="1"/>
                <separator invisible="1"/>
                <filter string="Late Activities" name="activities_overdue"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                    help="Show all records whose next activity date is past" invisible="1"/>
                <filter string="Today Activities" name="activities_today"
                    domain="[('my_activity_date_deadline', '=', 'today')]" invisible="1"/>
                <filter string="Future Activities" name="activities_upcoming_all"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
