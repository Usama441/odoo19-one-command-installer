<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_be_hr_payroll.VersionUpdateDialog">
        <Dialog>
            <t t-set-slot="header">
                <h4 class="modal-title text-wrap text-break fs-3 flex-grow-1">What is the effective date?</h4>
                <button type="button" class="btn-close" aria-label="Close" tabindex="-1" t-on-click="this.onDiscard"/>
            </t>
            <div>
                <div class="row align-items-start g-3">
                    <div class="col-md-7">
                        <p class="text-muted mb-2">This might create a new version to track changes.</p>
                        <div class="form-check my-2" t-if="this.props.nextPeriodStart">
                            <input class="form-check-input" type="radio" id="version_next_period" value="next_period" name="version_choice"
                                t-att-checked="this.choice() === 'next_period'"
                                t-on-change="(ev) => this.choice.set(ev.currentTarget.value)"/>
                            <label class="form-check-label fw-bold" for="version_next_period" t-out="this.formatDate(this.props.nextPeriodStart)"/>
                        </div>
                        <div class="form-check my-2">
                            <input class="form-check-input" type="radio" id="version_current" value="current_version" name="version_choice"
                                t-att-checked="this.choice() === 'current_version'"
                                t-on-change="(ev) => this.choice.set(ev.currentTarget.value)"/>
                            <label class="form-check-label fw-bold" for="version_current">
                                <t t-out="this.formatDate(this.props.currentVersionStart)"/> (current version)
                            </label>
                        </div>
                        <div class="form-check my-2">
                            <input class="form-check-input" type="radio" id="version_specific_date" value="specific_date" name="version_choice"
                                t-att-checked="this.choice() === 'specific_date'"
                                t-on-change="(ev) => this.choice.set(ev.currentTarget.value)"/>
                            <label class="form-check-label fw-bold" for="version_specific_date">Specific Date</label>
                        </div>
                        <div class="d-flex align-items-center gap-2 my-3" t-if="this.choice() === 'specific_date'">
                            <label class="fw-bold" for="version_date">Date:</label>
                            <DateTimeInput id="'version_date'" type="'date'" value="this.specificDate()"
                                onChange="(date) => this.specificDate.set(date)"/>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <t t-if="this.isNewVersion">
                            <div class="alert alert-info mt-3 mb-0" role="alert">
                                <span class="fs-4 me-2">⭐ <strong>Tips</strong></span>
                                <div class="small">
                                    You can create a new version using the button
                                    <span class="badge bg-300 px-2 py-1">+</span> in the top right corner
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning mt-3 mb-0" role="alert">
                                This change may impact <t t-esc="this.props.payslipsCount or 'existing'"/> payslips that you will need to correct
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onApply">Apply</button>
                <button class="btn btn-secondary" t-on-click="this.onDiscard">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
